# Market Space Backend Environment Variables (Example & Placeholders)

NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000/api/v1
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# Database
DATABASE_URL=postgresql://marketspace_app:secretpassword@localhost:5432/marketspace?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & JWT Tokens
JWT_ACCESS_SECRET=replace_with_64_character_hex_secret_in_production
JWT_REFRESH_SECRET=replace_with_64_character_hex_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# SMS Gateway (Egypt)
SMS_PROVIDER=SMS_MISR
SMS_MISR_USERNAME=placeholder_username
SMS_MISR_PASSWORD=placeholder_password
SMS_MISR_SENDER_ID=MarketSpace

# Storage (Cloudflare R2 / S3 Compatible)
R2_ACCOUNT_ID=placeholder_r2_account_id
R2_ACCESS_KEY_ID=placeholder_r2_access_key
R2_SECRET_ACCESS_KEY=placeholder_r2_secret_key
R2_BUCKET_NAME=marketspace-media-dev
R2_PUBLIC_DOMAIN=https://cdn.marketspace.eg

# Video Service (Cloudflare Stream)
CLOUDFLARE_STREAM_API_TOKEN=placeholder_stream_api_token
CLOUDFLARE_STREAM_ACCOUNT_ID=placeholder_stream_account_id
CLOUDFLARE_STREAM_WEBHOOK_SECRET=placeholder_stream_webhook_secret

# Payments (Paymob Egypt)
PAYMOB_API_KEY=placeholder_paymob_api_key
PAYMOB_INTEGRATION_ID_CARD=123456
PAYMOB_INTEGRATION_ID_WALLET=123457
PAYMOB_HMAC_SECRET=placeholder_paymob_hmac_secret

# Push Notifications (Firebase Cloud Messaging)
FIREBASE_PROJECT_ID=marketspace-dev
FIREBASE_CLIENT_EMAIL=placeholder@marketspace-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=placeholder_private_key
